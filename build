#!/bin/bash
set -e

# Build processes must never receive a private key or password. Sign separately.
if [ -n "$KS" ] || [ -n "$KSPASS" ] || [ -n "$KSPASS_FILE" ] || [ -n "$KEYSTORE" ] || [ -n "$KEYSTORE_BASE64" ]; then
  echo "Private signing inputs are forbidden during builds; use tools/sign_release.py after --unsigned preparation." >&2
  exit 2
fi
if [ -f .env ] && grep -Eq '(^|[[:space:]])(KS|KSPASS|KSPASS_FILE|KEYSTORE|KEYSTORE_BASE64)[[:space:]]*=' .env; then
  echo "Signing inputs must not be stored in the project .env file." >&2
  exit 2
fi

[ -z "$1" ] && echo "usage: ./build <directory>" && echo "e.g. ./build disass" && exit 1

# read .env
if [ -f .env ]
then
  export $(cat .env | sed 's/#.*//g' | xargs)
fi

[ -z "$JAVA_PATH" ] && JAVA_PATH=java
[ -z "$APKTOOL_PATH" ] && APKTOOL_PATH=/opt/apktool/apktool.jar
[ -z "$UBER_APK_SIGNER_PATH" ] && UBER_APK_SIGNER_PATH=/opt/uber-apk-signer/uber-apk-signer-1.2.1.jar

echo "JAVA_PATH: $JAVA_PATH"
echo "APKTOOL_PATH: $APKTOOL_PATH"
echo "UBER_APK_SIGNER_PATH: $UBER_APK_SIGNER_PATH"

# Set version
VERSION=$(jq -r ".version" bttv.manifest.json)
VERSIONCODE=$(jq -r ".versionCode" bttv.manifest.json)
sed -i "s/android:versionCode=\".*\"/android:versionCode=\"${VERSIONCODE}\"/" "$1/AndroidManifest.xml"
sed -i "s/android:versionName=\".*\"/android:versionName=\"${VERSION}\"/" "$1/AndroidManifest.xml"
sed -i "s/android:text=\"BTTV .*\"/android:text=\"BTTV Android CE ${VERSION}\"/" "$1/res/layout/settings_logout_footer.xml"

cd "$1"

APK_PATH=./dist/twitch.apk

# Build using APKTool. The split-aware intermediate APK has its own source
# filename, so set the final output path explicitly instead of relying on
# apktool.yml's apkFileName value.
$JAVA_PATH -Xmx6g -jar $APKTOOL_PATH b . --use-aapt2 -o "$APK_PATH"

# An unsigned intermediate is never labelled a verified release.
if [ "${BTTV_UNSIGNED_BUILD:-}" = 1 ]; then
  echo "Unsigned intermediate prepared: $APK_PATH"
  exit 0
fi

# Local development only: preserve the existing public test identity.
$JAVA_PATH -jar $UBER_APK_SIGNER_PATH -a "$APK_PATH"
rm "$APK_PATH"
mv ./dist/twitch-aligned-debugSigned.apk "$APK_PATH"

echo "Done: $APK_PATH"

